# AEGIS Environment Configuration
# Copy this file to .env and adjust values for your environment

# Application
APP_NAME=AEGIS
APP_VERSION=0.1.0
DEBUG=false

# Network Capture
# On Windows, use the full device GUID (obtained from test_capture.py)
# On Linux, use interface name like eth0, wlan0
CAPTURE_INTERFACE=\Device\NPF_{FC3C14A0-C35F-4038-9C6B-117B020AF461}
CAPTURE_FILTER=tcp or udp
CAPTURE_PROMISCUOUS=false

# Flow Processing
FLOW_WINDOW_SECONDS=5
FLOW_TIMEOUT_SECONDS=60

# Detection Thresholds
PORT_SCAN_THRESHOLD=20
PORT_SCAN_TIME_WINDOW=10
SYN_RATE_THRESHOLD=10.0
SYN_INCOMPLETE_RATIO=0.7
TRAFFIC_SPIKE_MULTIPLIER=3.0
TRAFFIC_BASELINE_WINDOW=60

# Threat Scoring
THREAT_SCORE_LOW=29
THREAT_SCORE_MEDIUM=59
THREAT_SCORE_HIGH=79

# Response Policy
SAFE_MODE=true
BLOCK_DURATION_SECONDS=60

# Database
# For SQLite (default):
DATABASE_URL=sqlite:///aegis.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/aegis

# API
API_HOST=127.0.0.1
API_PORT=8000

# Logging
LOG_LEVEL=INFO
